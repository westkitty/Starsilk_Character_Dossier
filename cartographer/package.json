{
  "name": "starsilk-temporal-cartographer",
  "version": "0.1.0",
  "private": true,
  "description": "STARSiLK Temporal Cartographer — standalone 3D galaxy / star system / historical-era authoring tool. Renderer + project JSON are designed for later embedding in the Starsilk Character Dossier.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:demo": "tsx scripts/write-demo-json.ts",
    "build:viewer": "tsc --noEmit && vite build --config vite.config.lib.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/three": "^0.169.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
