{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westkitty.github.io/Starsilk_Character_Dossier/machine/schema/v1/entity-index.schema.json",
  "title": "Starsilk entity index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_url", "project_id", "canonical_url", "record_count", "records"],
  "properties": {
    "schema": {"const": "starsilk-entity-index/1"},
    "schema_url": {"type": "string", "format": "uri"},
    "project_id": {"const": "starsilk-character-dossier"},
    "canonical_url": {"type": "string", "format": "uri"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {"$ref": "metadata-record.schema.json"}
    }
  }
}
