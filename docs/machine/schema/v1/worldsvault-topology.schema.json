{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westkitty.github.io/Starsilk_Character_Dossier/machine/schema/v1/worldsvault-topology.schema.json",
  "title": "Starsilk WorldsVault topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_url", "project_id", "canonical_url", "human_url", "node_count", "edge_count", "nodes", "edges", "unknowns", "interpretation_rules"],
  "properties": {"schema": {"const": "starsilk-worldsvault-topology/1"}, "schema_url": {"type": "string", "format": "uri"}, "project_id": {"const": "starsilk-character-dossier"}, "canonical_url": {"type": "string", "format": "uri"}, "human_url": {"type": "string", "format": "uri"}, "node_count": {"type": "integer", "minimum": 0}, "edge_count": {"type": "integer", "minimum": 0}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}, "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "interpretation_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
  "$defs": {"source": {"type": "object", "additionalProperties": false, "required": ["stable_id", "source_key", "path", "heading", "canonical_url", "legacy_url"], "properties": {"stable_id": {"type": "string", "minLength": 1}, "source_key": {"type": ["string", "null"]}, "path": {"type": "string", "pattern": "^src/content/sections/.+\\.body\\.html$"}, "heading": {"type": "string", "minLength": 1}, "canonical_url": {"type": "string", "format": "uri"}, "legacy_url": {"type": "string", "format": "uri"}}}, "status": {"type": "object", "additionalProperties": false, "required": ["visibility", "canon_status", "spoiler_level"], "properties": {"visibility": {"enum": ["public", "private", "unknown"]}, "canon_status": {"enum": ["canon", "development", "historical", "speculative", "unknown"]}, "spoiler_level": {"enum": ["none", "minor", "major", "unknown"]}}}, "layout": {"type": "object", "additionalProperties": false, "required": ["rendering_group", "rendering_order", "coordinate_status"], "properties": {"rendering_group": {"type": "string", "minLength": 1}, "rendering_order": {"type": "integer", "minimum": 1}, "coordinate_status": {"const": "non-canonical rendering order only"}}}, "node": {"type": "object", "additionalProperties": false, "required": ["node_id", "label", "node_class", "identity_status", "canonical_url", "source", "certainty", "status", "layout", "unknowns"], "properties": {"node_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "label": {"type": "string", "minLength": 1}, "node_class": {"type": "string", "minLength": 1}, "identity_status": {"enum": ["existing-authored-stable-id", "publication-derived"]}, "canonical_url": {"type": "string", "format": "uri"}, "source": {"$ref": "#/$defs/source"}, "certainty": {"const": "direct-authored"}, "status": {"$ref": "#/$defs/status"}, "layout": {"$ref": "#/$defs/layout"}, "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}, "edge": {"type": "object", "additionalProperties": false, "required": ["edge_id", "source", "target", "relation", "relation_class", "canonical_url", "source_evidence", "certainty", "status", "unknowns"], "properties": {"edge_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*--[a-z0-9][a-z0-9-]*--[a-z0-9][a-z0-9-]*$"}, "source": {"type": "string"}, "target": {"type": "string"}, "relation": {"enum": ["contains", "seeds", "located-in", "orbits", "uses"]}, "relation_class": {"const": "direct-authored-topology"}, "canonical_url": {"type": "string", "format": "uri"}, "source_evidence": {"$ref": "#/$defs/source"}, "certainty": {"const": "direct-authored"}, "status": {"$ref": "#/$defs/status"}, "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}
}
