{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westkitty.github.io/Starsilk_Character_Dossier/machine/schema/v1/cross-surface-record-index.schema.json",
  "title": "Starsilk Cross-Surface Record Index",
  "type": "object",
  "required": ["schema", "project_id", "canonical_url", "record_count", "evidence_classes", "records"],
  "properties": {
    "schema": {"const": "starsilk-cross-surface-record-index/1"},
    "project_id": {"const": "starsilk-character-dossier"},
    "canonical_url": {"type": "string", "format": "uri"},
    "record_count": {"type": "integer", "minimum": 1},
    "evidence_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "interpretation_rules": {"type": "array", "items": {"type": "string"}},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stable_id", "display_label", "canonical_url", "object_type", "source", "facets", "categories"],
        "properties": {
          "stable_id": {"type": "string", "minLength": 1},
          "display_label": {"type": "string", "minLength": 1},
          "canonical_url": {"type": "string", "format": "uri"},
          "object_type": {"type": "string", "minLength": 1},
          "source": {"type": "object"},
          "facets": {"type": "object"},
          "categories": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "url", "evidence_class", "source_pointer"],
                "properties": {
                  "label": {"type": "string"},
                  "url": {"type": "string"},
                  "evidence_class": {"type": "string"},
                  "source_pointer": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
