# Offline Archive Edition — the giant embedded-media source file.
# This must never enter Git history (see README.md for why). Not read by
# any normal build step; only build/migrate_legacy.py (a one-time,
# not-part-of-the-build import script) ever touches it.
starsilk_character_dossier.html
archive/

# The authored stable section ID `archive` has a generated public permalink.
# Keep the local/offline archive exclusion above while allowing this exact
# deterministic publication path to enter the committed docs/ tree.
!docs/entities/archive/
!docs/entities/archive/index.html

# Canonical original media (pre-optimization). Same rationale as the
# offline archive above: these are large, locally-held originals that
# media/manifest.json under docs/ traces back to via source_sha256 /
# source_filename, and every file here that predates this convention is
# still recoverable, byte-for-byte and unrewritten, from Git history at
# earlier commits of docs/assets/media/. Not read by any published page;
# only build/media_pipeline.py (source -> optimized derivative) reads it.
media/source/

# Superseded by media/source/ (unused by the current build; kept locally
# only if present).
starsilk header.mp4
.hero_video_work/

# Portable release packages (tools/package_release.py output).
dist/

# Backup / audit artifacts that may appear during local processing.
*.zip
*.zip.part*
*_before_*.html
audit-temp*
audit-output*
media_vault_fragment.html

# Build intermediates
.media_pipeline_tmp/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
