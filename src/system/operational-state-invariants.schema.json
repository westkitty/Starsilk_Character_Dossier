{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westkitty.github.io/Starsilk_Character_Dossier/system/operational-state-invariants.schema.json",
  "title": "Starsilk Operational State Invariant Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "scope", "invariants"],
  "properties": {
    "schema": {"const": "starsilk-capability-invariants/1"},
    "project_id": {"const": "starsilk-character-dossier"},
    "scope": {"const": "operational-state-freshness"},
    "invariants": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence", "proof"],
        "properties": {
          "id": {"pattern": "^OPS-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "proof": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
