{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westkitty.github.io/Starsilk_Character_Dossier/machine/schema/v1/chronology-index.schema.json",
  "title": "Starsilk chronology index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_url", "project_id", "canonical_url", "human_url", "source_record", "event_count", "events", "interpretation_rules"],
  "properties": {
    "schema": {"const": "starsilk-chronology-index/1"}, "schema_url": {"type": "string", "format": "uri"}, "project_id": {"const": "starsilk-character-dossier"}, "canonical_url": {"type": "string", "format": "uri"}, "human_url": {"type": "string", "format": "uri"},
    "source_record": {"type": "object", "additionalProperties": false, "required": ["stable_id", "source_key", "path", "canonical_url", "legacy_url"], "properties": {"stable_id": {"const": "chronology"}, "source_key": {"const": "five-phase-canon-chronology"}, "path": {"const": "src/content/sections/chronology.body.html"}, "canonical_url": {"type": "string", "format": "uri"}, "legacy_url": {"type": "string", "format": "uri"}}},
    "event_count": {"type": "integer", "minimum": 0}, "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}, "interpretation_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "event": {"type": "object", "additionalProperties": false, "required": ["event_id", "label", "canonical_url", "source", "visibility", "canon_status", "spoiler_level", "status_provenance", "temporal"], "properties": {"event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "label": {"type": "string", "minLength": 1}, "canonical_url": {"type": "string", "format": "uri"}, "source": {"type": "object", "additionalProperties": false, "required": ["stable_record_id", "source_key", "path", "heading", "canonical_url", "legacy_url"], "properties": {"stable_record_id": {"const": "chronology"}, "source_key": {"const": "five-phase-canon-chronology"}, "path": {"const": "src/content/sections/chronology.body.html"}, "heading": {"type": "string", "minLength": 1}, "canonical_url": {"type": "string", "format": "uri"}, "legacy_url": {"type": "string", "format": "uri"}}}, "visibility": {"enum": ["public", "private", "unknown"]}, "canon_status": {"enum": ["canon", "development", "historical", "speculative", "unknown"]}, "spoiler_level": {"enum": ["none", "minor", "major", "unknown"]}, "status_provenance": {"type": "object", "additionalProperties": false, "required": ["visibility", "canon_status", "spoiler_level"], "properties": {"visibility": {"type": "string"}, "canon_status": {"type": "string"}, "spoiler_level": {"type": "string"}}}, "temporal": {"$ref": "#/$defs/temporal"}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["certainty", "absolute_date", "exact_authored_marker", "relative_marker", "before_event_ids", "after_event_ids", "duration"], "properties": {"certainty": {"enum": ["exact-authored-marker", "relative-authored-marker", "authored-duration", "unknown"]}, "absolute_date": {"type": "null"}, "exact_authored_marker": {"type": ["string", "null"]}, "relative_marker": {"type": ["string", "null"]}, "before_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}, "after_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}, "duration": {"type": ["object", "null"], "additionalProperties": false, "required": ["authored_text", "value", "unit"], "properties": {"authored_text": {"type": "string", "minLength": 1}, "value": {"type": "integer", "minimum": 0}, "unit": {"const": "years"}}}}}
  }
}
