<aside id="readerWorkbench" class="reader-workbench" aria-labelledby="readerWorkbenchHeading" hidden>
<header class="reader-workbench-head"><div><span class="eyebrow">Local reader tools</span><h2 id="readerWorkbenchHeading">Reader Workbench</h2></div><div class="reader-workbench-head-actions"><button type="button" id="readerToWitness">Witness engine</button><button type="button" id="readerToRevision">Revision Chamber</button><button type="button" id="readerWorkbenchClose" aria-label="Close Reader Workbench">Close</button></div></header>
<p class="reader-workbench-privacy">Private to this browser. It stores only stable record IDs and reader preferences; it does not create canon, relationships, or a server-side account.</p>
<div id="readerWorkbenchStatus" role="status" aria-live="polite" class="reader-workbench-status"></div>
<div id="readerWorkbenchContent"></div>
</aside>
