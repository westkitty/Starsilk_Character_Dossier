<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1" name="viewport"/>
<meta content="dark" name="color-scheme"/>
<meta name="theme-color" content="#05070d"/>
<title>Starsilk Compendium</title>
<meta name="description" content="Starsilk Compendium — a source-backed canon archive for a universe where reality has a programmable substrate: characters, wars, Drakken, WorldsVault, visual locks, and the systems that bind them."/>
<link rel="canonical" href="{{ canonical_url }}"/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Starsilk Compendium"/>
<meta property="og:title" content="Starsilk Compendium"/>
<meta property="og:description" content="A source-backed canon archive for a universe where reality is programmable: characters, wars, Drakken, WorldsVault, visual locks, and cosmological systems."/>
<meta property="og:url" content="{{ canonical_url }}"/>
{% if og_image_url %}<meta property="og:image" content="{{ og_image_url }}"/>
<meta name="twitter:card" content="summary_large_image"/>{% else %}<meta name="twitter:card" content="summary"/>{% endif %}
<meta name="twitter:title" content="Starsilk Compendium"/>
<meta name="twitter:description" content="A source-backed canon archive for a universe where reality is programmable: characters, wars, Drakken, WorldsVault, visual locks, and cosmological systems."/>
<link rel="manifest" href="manifest.webmanifest"/>
<style>
{{ style_css }}
/* Root-only Witness Engine and Reader->Witness bridge. */
.reader-workbench-head-actions{display:flex;flex-wrap:wrap;gap:.4rem;justify-content:flex-end}
.witness-engine{position:fixed;z-index:95;inset:0;overflow:auto;background:radial-gradient(circle at 88% 6%,rgba(52,121,154,.18),transparent 26rem),#05070d;color:#eaf5fb;padding:0 clamp(1rem,3vw,2.4rem) 2rem}
.witness-engine[hidden]{display:none!important}.witness-engine-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid #294055;background:rgba(5,7,13,.96);backdrop-filter:blur(14px)}.witness-engine-head h2{margin:.1rem 0 0;font-size:clamp(1.8rem,4vw,3.3rem);letter-spacing:-.045em}.witness-engine button,.witness-file-label{min-height:44px;border:1px solid #31526e;border-radius:4px;background:#102234;color:#eaf5fb;font:700 .75rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase}.witness-engine button{padding:.55rem .8rem;cursor:pointer}.witness-engine button:hover,.witness-engine button:focus-visible,.witness-file-label:focus-within{border-color:var(--thread);background:#16324e;outline:2px solid var(--thread);outline-offset:2px}.witness-boundary{max-width:76rem;margin:1rem 0;color:#a9c0ce;font-size:.84rem}.witness-status{min-height:1.4rem;color:var(--thread2);font:700 .76rem/1.4 ui-monospace,SFMono-Regular,Menlo,monospace}.witness-engine-grid{display:grid;grid-template-columns:minmax(18rem,1fr) minmax(18rem,1fr) minmax(18rem,1fr);gap:1rem;align-items:start}.witness-pane{min-width:0;min-height:32rem;border:1px solid #22384b;background:rgba(8,17,27,.92);padding:1rem}.witness-pane h3{margin:.3rem 0 1rem;font-size:1.05rem}.witness-draft-pane textarea{width:100%;min-height:27rem;resize:vertical;background:#02060a;color:#eaf5fb;border:1px solid #31526e;border-radius:4px;padding:.9rem;font:400 .9rem/1.55 ui-monospace,SFMono-Regular,Menlo,monospace}.witness-draft-pane textarea:focus-visible{outline:2px solid var(--thread);outline-offset:2px}.witness-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.7rem}.witness-file-label{display:inline-flex;align-items:center;padding:.55rem .8rem;cursor:pointer}.witness-file-label input{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%)}.witness-footnote,.witness-empty{color:#8fa8b8;font-size:.8rem}.witness-counts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;margin-bottom:.8rem}.witness-counts span{border:1px solid #294055;background:#0b1621;padding:.55rem;font:700 .72rem/1.25 ui-monospace,SFMono-Regular,Menlo,monospace}.witness-counts b{display:block;margin-top:.2rem;color:#fff;font-size:1.25rem}.witness-diagnostics{display:grid;gap:.5rem}.witness-diagnostic{display:grid!important;gap:.25rem;width:100%;text-align:left;text-transform:none!important;letter-spacing:0!important;font-family:inherit!important}.witness-diagnostic strong{font:800 .76rem/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.04em}.witness-diagnostic span{color:#b7c8d3;font-size:.78rem;font-weight:400}.witness-conflict{border-left:4px solid #ff6b6b!important}.witness-locked{border-left:4px solid #d7b66b!important}.witness-recognized{border-left:4px solid #55dfff!important}.witness-supported{border-left:4px solid #76d9a0!important}.witness-source-local,.witness-unknown{border-left:4px solid #8293a3!important}.witness-literal{border-left:4px solid #c5a1ff!important}.witness-speech{border-left:4px solid #e6a5c9!important}.witness-trace-pane dl{display:grid;gap:.55rem}.witness-trace-pane dl div{border-top:1px solid #294055;padding-top:.5rem}.witness-trace-pane dt{color:#8fa8b8;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}.witness-trace-pane dd{margin:.15rem 0 0;overflow-wrap:anywhere}.witness-trace-pane blockquote{margin:1rem 0;padding:.7rem;border-left:2px solid var(--thread);background:#07111b;color:#c8d9e2;white-space:pre-wrap}.witness-trace-pane a{color:var(--thread)}.witness-export-actions{margin-top:1rem;border-top:1px solid #294055;padding-top:1rem}
@media(max-width:1100px){.witness-engine-grid{grid-template-columns:1fr 1fr}.witness-trace-pane{grid-column:1/-1;min-height:auto}}
@media(max-width:700px){ #witnessEngineToggle{display:none!important}.witness-engine{padding:0 .75rem 1rem}.witness-engine-head{align-items:flex-start}.witness-engine-grid{grid-template-columns:1fr}.witness-pane,.witness-trace-pane{grid-column:auto;min-height:auto}.witness-draft-pane textarea{min-height:45vh}.witness-actions>*{flex:1 1 10rem}.witness-counts{grid-template-columns:1fr 1fr}}
@media print{.witness-engine,#witnessEngineToggle{display:none!important}}
/* Preserve the HTML hidden contract even when component CSS sets display. */
[hidden]{display:none!important}
</style>
</head>
<body data-museum-shell="unified">
<a href="#mainContent" class="skip-link" tabindex="0">Skip to dossier content</a>

<video id="brandkit-watermark" muted playsinline aria-hidden="true"></video>
<aside class="index" id="index"><div class="index-head"><b>Starsilk / Index</b><button aria-label="Toggle dossier navigation" id="menuToggle" aria-expanded="false" aria-controls="indexPanel">Index</button></div><div class="index-panel" id="indexPanel"><div class="index-panel-inner"><nav>{% for group in nav_groups %}<details class="nav-group"{% if group.get('open', true) %} open{% endif %}><summary>{{ group.label }}<span class="chevron" aria-hidden="true"></span></summary><div class="nav-group-body">{% for item in group.links %}<a href="#{{ item.id }}">{{ item.label }}</a>{% endfor %}</div></details>{% endfor %}</nav><small>Web Edition · Character pages are print-separated.</small></div></div></aside>
<main id="mainContent" tabindex="-1"><div class="page-controls"><button type="button" id="expandAllBtn">Expand all</button><button type="button" id="collapseAllBtn">Collapse all</button><button type="button" id="sidebarToggle" aria-expanded="true" aria-controls="index">Hide index</button><button type="button" id="readerWorkbenchToggle" aria-expanded="false" aria-controls="readerWorkbench">Reader workbench</button><button type="button" id="witnessEngineToggle" aria-expanded="false" aria-controls="witnessEngine">Witness engine</button><button type="button" id="modeToggle" aria-pressed="false" hidden>Archive tools</button><button type="button" id="copyImplementationPrompt" hidden>Copy implementation prompt</button><span id="copyPromptStatus" class="visually-hidden" role="status" aria-live="polite"></span><div class="page-controls-search"><label for="dossierSearch" class="visually-hidden">Search dossier titles and content</label><input type="search" id="dossierSearch" placeholder="Search dossier&#8230;" aria-label="Search dossier titles and content" autocomplete="off"/><span id="dossierSearchStatus" role="status" aria-live="polite"></span></div></div>
{% for item in root_items %}{% if item.kind == 'drakken-folder' %}<details class="drakken-folder" id="drakken-folder"><summary><span class="drakken-folder-heading"><span class="eyebrow">Restricted archive</span><strong>Drakken</strong></span><span class="drakken-folder-note">Open to enter the complete Drakken register</span></summary><div class="drakken-folder-body">{% for section in item.sections %}{{ section.render() }}
{% endfor %}</div></details>
{% else %}{{ item.section.render() }}
{% if item.section.id == 'world' %}<div class="museum-entrance archive-junction" data-museum-shell="unified">
<section class="museum-hero archive-junction-shell" aria-labelledby="museum-hero-heading">
<div class="archive-junction-copy"><div class="eyebrow">Archive access</div><h2 id="museum-hero-heading">Choose a lens.</h2><p>The Compendium remains one canon record. These views expose the same material by identity, chronology, relation, media, and topology without inventing what the source does not say.</p></div>
<div class="museum-module-grid archive-lens-grid">
<a class="museum-module archive-lens" href="discover/"><span class="museum-module-eyebrow">Discover</span><h3>Search the record</h3><p>Filter stable records and source-backed excerpts.</p></a>
<a class="museum-module archive-lens" href="entities/"><span class="museum-module-eyebrow">Entities</span><h3>Open a folio</h3><p>Stable permalinks for every authored top-level record.</p></a>
<a class="museum-module archive-lens" href="objects/"><span class="museum-module-eyebrow">Objects</span><h3>See the evidence</h3><p>Published visual and media objects with provenance.</p></a>
<a class="museum-module archive-lens" href="relationships/"><span class="museum-module-eyebrow">Relationships</span><h3>Follow the references</h3><p>Only the cross-links the Compendium actually contains.</p></a>
<a class="museum-module archive-lens" href="canon/"><span class="museum-module-eyebrow">Canon</span><h3>Inspect the locks</h3><p>Machine-enforced protections for selected established facts.</p></a>
<a class="museum-module archive-lens" href="tours/"><span class="museum-module-eyebrow">Tours</span><h3>Take a route</h3><p>Curated paths plus private browser-local collections.</p></a>
<a class="museum-module archive-lens" href="chronology/"><span class="museum-module-eyebrow">Chronology</span><h3>Trace what happened</h3><p>Authored events, durations, and explicit unknowns.</p></a>
<a class="museum-module archive-lens" href="worldsvault/"><span class="museum-module-eyebrow">WorldsVault</span><h3>Read the topology</h3><p>Directly sourced cosmic relations without invented geography.</p></a>
</div>
<section class="museum-data-strip archive-machine-row" aria-labelledby="museum-data-heading"><div><div class="eyebrow">Machine access</div><h2 id="museum-data-heading">The same record, structured.</h2><p>Deterministic derivatives and orientation files for tools that need the Compendium without a visual interface.</p></div><div class="museum-data-links"><a href="agents/AGENT_GUIDE.md">Agent guide</a><a href="machine/index.json">Machine index</a><a href="llms.txt">llms.txt</a><a href="sitemap.xml">Sitemap</a></div></section>
<details class="archive-stats"><summary>Collection statistics</summary><dl class="museum-hero-stats" aria-label="Collection totals"><div><dt>Compendium records</dt><dd>{{ museum_stats.record_count }}</dd></div><div><dt>Published media objects</dt><dd>{{ museum_stats.object_count }}</dd></div><div><dt>Cross-referenced links</dt><dd>MUSEUM_LINK_COUNT_PLACEHOLDER</dd></div><div><dt>Chronology events</dt><dd>{{ museum_stats.event_count }}</dd></div><div><dt>Curated tours</dt><dd>{{ museum_stats.tour_count }}</dd></div><div><dt>Machine-enforced canon locks</dt><dd>{{ museum_stats.canon_lock_count }}</dd></div></dl></details>
</section>
</div>{% endif %}
{% endif %}{% endfor %}<section class="page footer" data-folio="{{ footer_folio }}"><div class="eyebrow">Standalone reference</div><h2>Keep the contradiction.<br/>Keep the silhouette.</h2><p>This is the Web Edition: canon prose lives in this document, media is delivered as externalized, deduplicated files under <code>assets/media/</code> rather than embedded inline. Character locks override stale sheet annotations, unresolved canon conflicts remain explicit, and no third-party network resource is required to read the dossier.</p><p class="subtle" style="font-size:.78rem">Text, art, and media in this dossier are shared here for reference within the Starsilk project. Their presence on GitHub is not a grant of reuse rights &#8212; see <a href="RIGHTS.md">RIGHTS.md</a>.</p></section>
</main>
<script>
{{ app_js }}
</script>
<aside id="readerWorkbench" class="reader-workbench" aria-labelledby="readerWorkbenchHeading" hidden>
<header class="reader-workbench-head"><div><span class="eyebrow">Local reader tools</span><h2 id="readerWorkbenchHeading">Reader Workbench</h2></div><div class="reader-workbench-head-actions"><button type="button" id="readerToWitness">Witness engine</button><button type="button" id="readerWorkbenchClose" aria-label="Close Reader Workbench">Close</button></div></header>
<p class="reader-workbench-privacy">Private to this browser. It stores only stable record IDs and reader preferences; it does not create canon, relationships, or a server-side account.</p>
<div id="readerWorkbenchStatus" role="status" aria-live="polite" class="reader-workbench-status"></div>
<div id="readerWorkbenchContent"></div>
</aside>
<script>
{{ reader_workbench_js }}
</script>
<aside id="witnessEngine" class="witness-engine" aria-labelledby="witnessEngineHeading" aria-describedby="witnessEngineBoundary" hidden>
<header class="witness-engine-head"><div><span class="eyebrow">Canon compile desk</span><h2 id="witnessEngineHeading">Witness Engine</h2></div><button type="button" id="witnessEngineClose" aria-label="Close Witness Engine">Close</button></header>
<p id="witnessEngineBoundary" class="witness-boundary">Draft text stays in browser memory. The compiler may point to existing records and machine-enforced locks; it cannot promote a sentence into canon, invent missing evidence, or turn an absent lock into a negative fact.</p>
<div id="witnessStatus" class="witness-status" role="status" aria-live="polite"></div>
<div class="witness-engine-grid">
<section class="witness-pane witness-draft-pane" aria-labelledby="witnessDraftHeading"><span class="eyebrow">01 / Draft</span><h3 id="witnessDraftHeading">What are you trying to make true?</h3><label for="witnessDraft" class="visually-hidden">Draft text to compile against Starsilk evidence</label><textarea id="witnessDraft" maxlength="300000" spellcheck="true" placeholder="Paste a scene, lore note, song, dossier passage, prompt, or other draft here…"></textarea><div class="witness-actions"><label class="witness-file-label" for="witnessFile">Import text<input id="witnessFile" type="file" accept=".txt,.md,text/plain,text/markdown"/></label><button type="button" id="witnessCompile">Compile draft</button><button type="button" id="witnessClear">Clear</button></div><p class="witness-footnote">No draft persistence. Reloading the page destroys the working text.</p></section>
<section class="witness-pane witness-report-pane" aria-labelledby="witnessReportHeading"><span class="eyebrow">02 / Compile report</span><h3 id="witnessReportHeading">What the archive can actually establish</h3><div id="witnessReport"><p class="witness-empty">Nothing compiled yet.</p></div></section>
<section class="witness-pane witness-trace-pane" aria-labelledby="witnessTraceHeading"><span class="eyebrow">03 / Witness trace</span><h3 id="witnessTraceHeading">Why did it say that?</h3><div id="witnessTrace"><div class="witness-trace-empty"><p>Select a diagnostic after compiling.</p></div></div><div class="witness-actions witness-export-actions"><button type="button" id="witnessCopyPack">Copy context pack</button><button type="button" id="witnessDownloadReport">Export report</button></div></section>
</div>
</aside>
<script>window.STARSILK_WITNESS_DATA=JSON.parse(new TextDecoder().decode(Uint8Array.from(atob("{{ witness_data_b64 }}"),function(c){return c.charCodeAt(0);})));</script>
<script>
{{ witness_engine_js }}
</script>
<script src="offline-client.js"></script>
</body></html>
