<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>WorldsVault cosmic topology — {{ project_name }}</title><link rel="canonical" href="{{ canonical_url }}"><link rel="stylesheet" href="worldsvault.css"></head>
<body>
<a class="skip-link" href="#topology">Skip to topology</a>
<header class="site-head"><p class="eyebrow">Source-backed explorer</p><h1>WorldsVault cosmic topology</h1><p>Direct authored relations only. Rendering arrangement is not a map or a cosmic coordinate system.</p><nav aria-label="Museum navigation"><a href="../">Complete Compendium</a><a href="../entities/">Entities</a><a href="../relationships/">Relationship observatory</a><a href="../chronology/">Chronology</a></nav></header>
<main id="topology">
  <section class="boundary" aria-labelledby="boundary-heading"><h2 id="boundary-heading">Interpretation boundary</h2><ul>{% for rule in model.interpretation_rules %}<li>{{ rule }}</li>{% endfor %}</ul></section>
  <section aria-labelledby="visual-heading"><h2 id="visual-heading">Topology explorer</h2><p id="topologyStatus" aria-live="polite">{{ model.node_count }} source-backed nodes and {{ model.edge_count }} direct authored edges.</p><div class="topology-controls"><button type="button" id="showAll" aria-pressed="true">Show all</button><button type="button" id="clearSelection">Clear selection</button></div>
    <div class="topology-grid" aria-label="Non-canonical topology layout">
      {% for node in model.nodes %}<article id="node-{{ node.node_id }}" class="topology-node" tabindex="0" data-node-id="{{ node.node_id }}" data-layout-group="{{ node.layout.rendering_group }}"><p class="node-class">{{ node.node_class }}</p><h3><a href="#node-{{ node.node_id }}">{{ node.label }}</a></h3><p><code>{{ node.node_id }}</code> · {{ node.identity_status }}</p><p><a href="{{ node.source.canonical_url }}">Source: {{ node.source.stable_id }}</a> — {{ node.source.heading }}</p><p class="noncanonical">{{ node.layout.coordinate_status }}</p></article>{% endfor %}
    </div>
  </section>
  <section class="edge-list" aria-labelledby="edges-heading"><h2 id="edges-heading">Direct authored edges</h2><ol>{% for edge in model.edges %}<li id="edge-{{ edge.edge_id }}" data-edge-id="{{ edge.edge_id }}" data-source="{{ edge.source }}" data-target="{{ edge.target }}"><a href="#node-{{ edge.source }}">{{ edge.source }}</a> <strong>{{ edge.relation }}</strong> <a href="#node-{{ edge.target }}">{{ edge.target }}</a> <span>· direct authored · <a href="{{ edge.source_evidence.canonical_url }}">{{ edge.source_evidence.stable_id }}: {{ edge.source_evidence.heading }}</a></span></li>{% endfor %}</ol></section>
  <section aria-labelledby="text-heading"><h2 id="text-heading">Text equivalent</h2><p>The list above is the complete accessible textual equivalent of the visual arrangement: each relation names both endpoints, relation, certainty, and source. It makes no directional, metric, or coordinate claim beyond its cited wording.</p><details><summary>Unknowns preserved</summary><ul>{% for unknown in model.unknowns %}<li>{{ unknown }}</li>{% endfor %}</ul></details><p><a href="worldsvault.json">JSON topology</a> · <a href="worldsvault.md">Markdown topology</a> · <a href="schema.json">Schema</a> · <a href="AUTHORITY.md">Authority boundary</a></p></section>
</main><script src="worldsvault.js"></script></body></html>
