<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="color-scheme" content="dark">
  <title>Living Archive — Source Register | Starsilk Compendium</title>
  <link rel="canonical" href="{{ url }}">
  <style>
    :root { color-scheme: dark; font-family: Georgia, "Times New Roman", serif;
      background: #10151a; color: #eef2ef; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: radial-gradient(ellipse at top,#25313b 0%,#10151a 46%); }
    a { color: #aee3db; text-underline-offset: .18em; }
    a:hover { color: #e9fff8; }
    :focus-visible { outline: 3px solid #f8d78b; outline-offset: 4px; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: clamp(24px,5vw,64px) clamp(18px,4vw,40px) 80px; }
    .overline { font: 700 .76rem/1.5 system-ui,sans-serif; color: #c1cfd1; text-transform: uppercase; letter-spacing: .17em; }
    h1 { font-size: clamp(2.4rem,7vw,5rem); font-weight: 400; letter-spacing: -.035em; line-height: 1.06; margin: .4em 0 .2em; }
    .intro { max-width: 72ch; font: 1.1rem/1.8 system-ui,sans-serif; color: #d6dfe0; }
    .notice { border-left: 3px solid #d8b77b; background: #222a2e; padding: 14px 20px; margin: 28px 0 40px; }
    .notice p { margin: 0; font: .95rem/1.7 system-ui,sans-serif; }
    .count { font: 700 .87rem/1.5 system-ui,sans-serif; color: #bbcdd2; margin-bottom: 18px; }
    .cards { list-style: none; margin: 0; padding: 0; display: grid;
      grid-template-columns: repeat(auto-fit,minmax(min(100%,320px),1fr)); gap: 18px; }
    .card { background: #1c262d; border: 1px solid #455861; border-radius: 8px; padding: 24px; }
    .card h2 { font-size: 1.55rem; font-weight: 400; line-height: 1.18; margin: .5em 0; overflow-wrap: anywhere; }
    .eyebrow { font: 700 .72rem/1.5 system-ui,sans-serif; letter-spacing: .11em;
      text-transform: uppercase; color: #c6d9db; }
    .hold { display: inline-block; padding: 4px 8px; border: 1px solid #d8b77b;
      color: #f7d9a1; font: 700 .76rem/1.4 system-ui,sans-serif; border-radius: 3px; }
    .detail, .meta, .source { font: .93rem/1.65 system-ui,sans-serif; color: #d6dfe0; }
    .meta { color: #b8cad0; }
    .meta code { font-size: .87rem; color: #f0e5c8; }
    .source { margin-top: 16px; overflow-wrap: anywhere; }
    footer { border-top: 1px solid #536269; margin-top: 44px; padding-top: 20px;
      color: #c5d0d2; font: .88rem/1.8 system-ui,sans-serif; }
    @media(max-width:480px) { .card { padding: 19px; } .wrap { padding-top: 28px; } }
  </style>
</head>
<body>
  <main class="wrap" id="main">
    <p class="overline">Starsilk Compendium · Independent source register</p>
    <h1>Living Archive</h1>
    <p class="intro">A register of independently developed interactive works. These entries are source references, not canon endorsements, playable exhibits, or an invitation to reproduce another project's artwork.</p>
    <div class="notice" role="note"><p><strong>Phase 1: admission withheld.</strong> No exhibit can launch or embed here. Deployment records do not prove live-browser parity. Private archives are excluded completely; status and source rights require separate review.</p></div>
    <p class="count">{{ records | length }} public-source records · all exhibition launches on hold</p>
    {% if records %}
    <ul class="cards" aria-label="Public guest-source records">
    {% for exhibit in records %}
      <li class="card">
        <span class="eyebrow">{{ exhibit.collection }} · {{ exhibit.canon_status }} interpretation</span>
        <h2>{{ exhibit.title }}</h2>
        <span class="hold">Exhibit on hold</span>
        <p class="detail">{{ exhibit.hold_reason }}</p>
        <p class="meta">Deployment evidence: {{ exhibit.evidence_state | replace('-', ' ') }}<br>
          Live edge: {{ exhibit.live_edge }}<br>
          Spoiler classification: {{ exhibit.spoiler_level }}</p>
        <p class="source"><a href="{{ exhibit.source_url }}" rel="noopener noreferrer" target="_blank">View pinned public GitHub source ({{ exhibit.source_commit[:10] }})</a></p>
      </li>
    {% endfor %}
    </ul>
    {% else %}
      <p>No guest source records are approved for public metadata display.</p>
    {% endif %}
    <footer>
      <p>Curatorial metadata only. Unverified facts remain unknown. The Starsilk Compendium's canon, media records and existing exhibits have not changed.</p>
      <p><a href="{{ root_url }}">Return to the Starsilk Compendium</a></p>
    </footer>
  </main>
</body>
</html>
