<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cross-Surface Record Explorer · Starsilk Compendium</title>
<meta name="description" content="Search source-backed Starsilk records across canon locks, chronology, observed mentions, media, tours, WorldsVault, films, and machine alternatives.">
<link rel="canonical" href="{{ canonical_url|e }}"><link rel="alternate" type="application/json" href="records.json"><link rel="stylesheet" href="records.css">
</head>
<body class="record-explorer-shell"><a class="skip-link" href="#main">Skip to records</a>
{% set nav_root = '../' %}{% set nav_current = 'records' %}{% include "_museum_nav.html.j2" %}
<main id="main" class="record-main"><header class="record-hero"><div class="record-kicker">Evidence-indexed museum navigation</div><h1>Cross-Surface Record Explorer</h1><p>One stable record at a time, across evidence that already exists. Categories appear only when source-backed. Observed mentions stay mentions; chronology stays authored; unknown stays unknown.</p></header>
<section class="record-controls" aria-label="Record search and filters"><label>Search records<input id="recordQuery" type="search" autocomplete="off" placeholder="Name, stable ID, type…"></label><label>Record type<select id="recordType"><option value="">All types</option>{% for item in object_types %}<option value="{{ item|e }}">{{ item|e }}</option>{% endfor %}</select></label><div class="record-facets" role="group" aria-label="Evidence presence filters">{% for key,label in facet_labels %}<label><input type="checkbox" data-record-facet="{{ key|e }}"> {{ label|e }}</label>{% endfor %}</div><div class="record-control-foot"><span id="recordStatus" class="record-status" aria-live="polite">Loading records…</span><button id="recordReset" type="button">Reset filters</button></div></section>
<ol class="record-grid" id="recordGrid" aria-label="Stable records"></ol><p id="recordLoadError" hidden>The local record search index could not be loaded. The full machine index remains available from Data / AI.</p></main><script src="records.js" defer></script></body></html>
