{# Shared unified navigation, included by every secondary system template
   and entity records. Callers must set `nav_root` (relative path prefix
   back to docs/ root -- '../' one level down, '../../' for entity records)
   and `nav_current` (a key from the list below, or omit for no active
   marker) before including this file. The root page (shell.html.j2) does
   not include this partial -- its sticky top bar is reader controls only
   (expand/collapse/index/search); every system is reachable from its
   exploration cards instead. See src/templates/discovery.html.j2 for a
   typical caller. #}
<style>
.museum-nav{position:relative;z-index:30;display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1.4rem;padding:.85rem clamp(1rem,3vw,2rem);background:rgba(5,7,13,.96);border-bottom:1px solid #213145;font:16px/1.4 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.museum-nav-brand{display:inline-flex;align-items:baseline;gap:.4rem;font:800 .95rem/1.1 ui-sans-serif,system-ui,sans-serif;letter-spacing:.01em;color:#eef3f6;text-decoration:none;white-space:nowrap}
.museum-nav-brand em{font-style:normal;color:#55dfff}
.museum-nav-mark{color:#55dfff;font-size:.9em}
.museum-nav>nav{flex:1 1 auto;min-width:0}
.museum-nav-links{display:flex;flex-wrap:wrap;gap:.05rem 1.1rem;list-style:none;margin:0;padding:0}
.museum-nav-links a{display:inline-flex;padding:.4rem .1rem;color:#9fb1bf;text-decoration:none;font:700 .72rem/1.1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase;border-bottom:2px solid transparent;min-height:44px;align-items:center}
.museum-nav-links a:hover,.museum-nav-links a:focus-visible{color:#fff;border-bottom-color:#55dfff;outline:none}
.museum-nav-links a[aria-current="page"]{color:#55dfff;border-bottom-color:#55dfff}
.museum-nav-data{position:relative;font-size:.74rem}
.museum-nav-data>summary{cursor:pointer;list-style:none;padding:.4rem .75rem;border:1px solid #2b4966;border-radius:4px;color:#c9d5df;font:700 .7rem/1.1 ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.06em;min-height:44px;display:inline-flex;align-items:center}
.museum-nav-data>summary::-webkit-details-marker{display:none}
.museum-nav-data[open]>summary{color:#55dfff;border-color:#55dfff}
.museum-nav-data-panel{position:absolute;right:0;top:calc(100% + .4rem);display:flex;flex-direction:column;gap:.3rem;padding:.6rem;background:#0d1320;border:1px solid #27374b;border-radius:6px;min-width:11rem;box-shadow:0 12px 30px rgba(0,0,0,.5)}
.museum-nav-data-panel a{color:#9fb1bf;text-decoration:none;font-size:.78rem;padding:.25rem 0}
.museum-nav-data-panel a:hover,.museum-nav-data-panel a:focus-visible{color:#fff}
@media(max-width:700px){
.museum-nav{gap:.5rem .8rem;padding:.65rem .9rem}
.museum-nav>nav{flex-basis:100%;order:3;min-width:100%}
.museum-nav-links{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;gap:0 .9rem;padding-bottom:.15rem}
.museum-nav-links a{flex:0 0 auto}
.museum-nav-data{order:2;margin-left:auto}
}
</style>
<header class="museum-nav" data-museum-shell="unified">
{% set _compendium_href = nav_root + '#mainContent' %}
<a class="museum-nav-brand" href="{{ nav_root }}"><span class="museum-nav-mark" aria-hidden="true">&#10022;</span>Starsilk <em>Compendium</em></a>
<nav aria-label="Unified Starsilk Compendium navigation">
<ul class="museum-nav-links">
<li><a href="{{ nav_root }}"{% if nav_current == 'home' %} aria-current="page"{% endif %}>Home</a></li>
<li><a href="{{ _compendium_href }}"{% if nav_current == 'compendium' %} aria-current="page"{% endif %}>Compendium</a></li>
<li><a href="{{ nav_root }}discover/"{% if nav_current == 'discover' %} aria-current="page"{% endif %}>Discover</a></li>
<li><a href="{{ nav_root }}entities/"{% if nav_current == 'entities' %} aria-current="page"{% endif %}>Entities</a></li>
<li><a href="{{ nav_root }}objects/"{% if nav_current == 'objects' %} aria-current="page"{% endif %}>Objects</a></li>
<li><a href="{{ nav_root }}relationships/"{% if nav_current == 'relationships' %} aria-current="page"{% endif %}>Relationships</a></li>
<li><a href="{{ nav_root }}canon/"{% if nav_current == 'canon' %} aria-current="page"{% endif %}>Canon Inspector</a></li>
<li><a href="{{ nav_root }}tours/"{% if nav_current == 'tours' %} aria-current="page"{% endif %}>Tours</a></li>
<li><a href="{{ nav_root }}chronology/"{% if nav_current == 'chronology' %} aria-current="page"{% endif %}>Chronology</a></li>
<li><a href="{{ nav_root }}worldsvault/"{% if nav_current == 'worldsvault' %} aria-current="page"{% endif %}>WorldsVault</a></li>
</ul>
</nav>
<details class="museum-nav-data">
<summary>Data / AI</summary>
<div class="museum-nav-data-panel">
<a href="{{ nav_root }}agents/AGENT_GUIDE.md">Agent guide</a>
<a href="{{ nav_root }}machine/index.json">Machine index</a>
<a href="{{ nav_root }}llms.txt">llms.txt</a>
</div>
</details>
</header>
